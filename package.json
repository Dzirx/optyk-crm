{
  "name": "optyk-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:seed:auto && next dev",
    "build": "prisma generate && next build",
    "start": "npm run db:seed:auto && next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx lib/db/seed.ts",
    "db:seed:auto": "tsx lib/db/seed.ts --silent",
    "postinstall": "prisma generate",
    "test:unit": "TZ=UTC node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "bash tests/e2e/run.sh",
    "test:edition": "bash tests/e2e/edition.sh",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "motion": "14.6.0",
    "next": "16.1.1",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
